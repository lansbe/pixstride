# Public source allowlist. Unlisted local artifacts stay private.
*
!/.gitignore
!/.dockerignore
!/.editorconfig
!/Cargo.toml
!/Cargo.lock
!/build.rs
!/Dockerfile
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/SECURITY.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/COMPATIBILITY.md
!/BENCHMARKS.md
!/BENCHMARKS_V2.md
!/benchmarks/
!/benchmarks/cases.json
!/benchmarks/cases-v2.json
!/benchmarks/versions-v2.json
!/benchmarks/allocator_profile.c
!/benchmarks/allocator_diagnostics.h
!/benchmarks/versions.json
!/benchmarks/released-versions.json
!/benchmarks/results/
!/benchmarks/results/*.json
!/benchmarks/results/*.json.gz
!/benchmarks/results/v2/
!/benchmarks/results/v2/*.json
!/benchmarks/results/v2/*.json.gz
!/scripts/
!/scripts/*.py
!/scripts/build_native_codecs.sh
!/scripts/build_native_vips.sh
!/vendor/
!/vendor/rs-vips/
!/vendor/rs-vips/Cargo.toml
!/vendor/rs-vips/README.md
!/vendor/rs-vips/LICENSE
!/vendor/rs-vips/build.rs
!/vendor/rs-vips/src/
!/vendor/rs-vips/src/*.rs
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/checks/project/
!/.github/checks/project/*.py
!/.github/checks/compatibility/
!/.github/checks/compatibility/*.json
!/src/
!/src/**/
!/src/**/*.rs
!/.github/
!/.github/workflows/
!/.github/workflows/container.yml
!/.github/workflows/benchmark.yml
!/.github/workflows/benchmark-v1.yml
!/.github/workflows/benchmark-candidate.yml
!/.github/workflows/benchmark-v2-candidate.yml
!/.github/workflows/allocator-diagnostics.yml
!/.github/dependabot.yml
!/.github/checks/
!/.github/checks/abi/
!/.github/checks/abi/*.rs
!/.github/checks/abi/*.c
!/.github/checks/abi/*.sh

# Third-party benchmark harness. Allow only its build inputs and evidence.
!/.github/workflows/peer-reference.yml
!/.github/workflows/peer-native.yml
!/.github/workflows/peer-measure.yml
!/.github/actions/
!/.github/actions/peer-inputs/
!/.github/actions/peer-inputs/action.yml
!/benchmarks/peers/
!/benchmarks/peers/*/
!/benchmarks/peers/*/Dockerfile
!/benchmarks/peers/*/adapter.py
!/benchmarks/peers/thumbor/requirements.txt
!/benchmarks/peers/thumbor/thumbor.conf
!/benchmarks/peers/ipx/package.json
!/benchmarks/peers/ipx/package-lock.json
!/benchmarks/peers/ipx/server.mjs
!/benchmarks/peers/imageflow/ImageflowBench.csproj
!/benchmarks/peers/imageflow/Program.cs
!/benchmarks/peers/weserv/nginx.conf

# Never version build output, credentials, media, or editor files.
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.profraw
**/*.profdata
**/target/
**/.idea/
**/.vscode/
