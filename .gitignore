# Public source allowlist. Unlisted local artifacts stay private.
*
!/.gitignore
!/.dockerignore
!/.editorconfig
!/Cargo.toml
!/Cargo.lock
!/build.rs
!/Dockerfile
!/README.md
!/LICENSE
!/SECURITY.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/COMPATIBILITY.md
!/scripts/
!/scripts/*.py
!/vendor/
!/vendor/rs-vips/
!/vendor/rs-vips/Cargo.toml
!/vendor/rs-vips/README.md
!/vendor/rs-vips/LICENSE
!/vendor/rs-vips/build.rs
!/vendor/rs-vips/src/
!/vendor/rs-vips/src/*.rs
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/checks/project/
!/.github/checks/project/*.py
!/.github/checks/compatibility/
!/.github/checks/compatibility/*.json
!/src/
!/src/**/
!/src/**/*.rs
!/.github/
!/.github/workflows/
!/.github/workflows/container.yml
!/.github/dependabot.yml
!/.github/checks/
!/.github/checks/abi/
!/.github/checks/abi/*.rs
!/.github/checks/abi/*.c
!/.github/checks/abi/*.sh

# Never version build output, credentials, media, or editor files.
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.profraw
**/*.profdata
**/target/
**/.idea/
**/.vscode/
